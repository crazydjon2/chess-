{
  "name": "chessplus",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "start": "npm start --prefix server",
    "balance": "node tools/balance/run.js",
    "balance:quick": "node tools/balance/run.js --preset quick",
    "balance:deep": "node tools/balance/run.js --preset deep",
    "ui-test": "node tools/ui-e2e/run.js",
    "ui-test:all": "node tools/ui-e2e/run.js --all-profiles"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright-core": "^1.64.1",
    "vitest": "^3.2.4"
  }
}
